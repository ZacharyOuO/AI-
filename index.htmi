<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CubeAI 波段戰情室 Massive | AI 七大次族群（各20檔熱門股） × 籌碼診斷系統</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            bg: '#090D16',
            panel: '#111827',
            panelHover: '#1E293B',
            border: '#1F2937',
            twRed: '#EF4444',
            twGreen: '#10B981',
            accent: '#3B82F6',
            gold: '#F59E0B'
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #090D16; color: #F3F4F6; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #090D16; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
    .glass-card { background: rgba(17, 24, 39, 0.88); backdrop-filter: blur(12px); border: 1px solid rgba(51, 65, 85, 0.6); }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans selection:bg-blue-600 selection:text-white">

  <!-- 頂部導覽列 -->
  <header class="sticky top-0 z-30 bg-bg/95 backdrop-blur border-b border-slate-800 px-4 py-2.5">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center font-mono font-bold text-lg shadow-lg shadow-blue-900/40">
          AI
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-bold text-base md:text-lg tracking-tight text-white">CubeAI 波段戰情室 Massive</h1>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">七大次族群（各20檔熱門股）</span>
          </div>
          <p class="text-xs text-slate-400">聚焦：AI 全產業鏈 ｜ 每日情報消息 ｜ 互動 K 線與四維度籌碼診斷</p>
        </div>
      </div>

      <!-- 即時盤勢微看板 -->
      <div class="flex items-center gap-3 overflow-x-auto py-1 text-xs font-mono">
        <div class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">
          <span class="text-slate-400">加權指數</span>
          <span class="ml-1.5 font-semibold text-emerald-400">46,041 ▼1.8%</span>
        </div>
        <div class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">
          <span class="text-slate-400">費城半導體</span>
          <span class="ml-1.5 font-semibold text-emerald-400">10,732 ▼6.72%</span>
        </div>
        <div class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">
          <span class="text-slate-400">NVDA</span>
          <span class="ml-1.5 font-semibold text-red-400">$222.01 ▲2.54%</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="openWatchlistModal()" class="text-xs px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium transition flex items-center gap-1.5">
          <span>⭐</span> 管理我的自選股 (<span id="watchlist-count">0</span>)
        </button>
      </div>
    </div>
  </header>

  <!-- 主內容區 -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 space-y-6">

    <!-- 區塊 1：早報總覽與 AI 次族群過濾 -->
    <section class="glass-card rounded-xl p-5 border-l-4 border-l-amber-500">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2 text-xs font-mono text-amber-400 mb-1">
            <span>📅 2026-10-24 盤前早報官定調</span>
            <span>•</span>
            <span>AI 員工：#01 盤前情報與次族群雷達官</span>
          </div>
          <h2 class="text-lg md:text-xl font-bold text-white">
            費半高檔回測季線、NVDA 逆勢抗跌！台股採「買黑不買紅、鎖定高毛利 PCB 與光通訊」
          </h2>
        </div>
        <div class="text-right shrink-0">
          <div class="text-[11px] text-slate-400">今日波段攻擊指數</div>
          <div class="text-base font-bold text-amber-400">65 / 100（選股不選市・拉回低接）</div>
        </div>
      </div>

      <div class="mt-4">
        <div class="text-xs font-semibold text-slate-300 mb-2">🧭 AI 七大次族群篩選（每族群精選 20 檔熱門標的）：</div>
        <div id="sector-tabs" class="flex flex-wrap gap-2"></div>
      </div>
    </section>

    <!-- 區塊 2：每日關鍵新聞消息雷達 -->
    <section class="space-y-3">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
          <span>📰</span> 每日三大關鍵消息雷達（川普政經 ｜ 新技術突破 ｜ 大廠財報）
        </h3>
        <div class="flex gap-1.5 text-xs">
          <button onclick="filterNewsType('ALL')" class="news-type-btn px-2.5 py-1 rounded bg-slate-800 text-white font-medium">全部消息</button>
          <button onclick="filterNewsType('TRUMP')" class="news-type-btn px-2.5 py-1 rounded bg-slate-900 text-slate-400 hover:text-white">🦅 川普與政經</button>
          <button onclick="filterNewsType('TECH')" class="news-type-btn px-2.5 py-1 rounded bg-slate-900 text-slate-400 hover:text-white">🚀 新技術突破</button>
          <button onclick="filterNewsType('EARNINGS')" class="news-type-btn px-2.5 py-1 rounded bg-slate-900 text-slate-400 hover:text-white">📑 財報與法說</button>
        </div>
      </div>
      <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    </section>

    <!-- 區塊 3：進階條件選股器 -->
    <section class="glass-card rounded-xl p-4 border border-indigo-500/30">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span>⚡</span> 進階 AI 條件選股器 (Smart Screener)
          </h3>
          <p class="text-xs text-slate-400">一鍵篩選符合「投信認養 ＋ 均線排列 ＋ 籌碼狀態」的高勝率標的</p>
        </div>
        <div class="flex flex-wrap gap-1.5 text-xs">
          <button onclick="applyScreener('ALL')" class="screener-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-medium">全部標的</button>
          <button onclick="applyScreener('BULL_INVESTMENT')" class="screener-btn px-3 py-1.5 rounded-lg bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800">🔥 投信連買 ＋ 多頭排列</button>
          <button onclick="applyScreener('PULLBACK_SUPPORT')" class="screener-btn px-3 py-1.5 rounded-lg bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800">⚡ 投信買超 ＋ 月線拉回</button>
          <button onclick="applyScreener('FOREIGN_DEFENSE')" class="screener-btn px-3 py-1.5 rounded-lg bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800">🛡️ 外資權值防守股</button>
        </div>
      </div>
    </section>

    <!-- 區塊 4：【核心診斷面板】互動式 K線籌碼圖 + 四維度戰力 + 策略計算機 -->
    <section class="glass-card rounded-xl p-5 border border-blue-500/30">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2 text-xs font-mono text-blue-400 mb-1">
            <span>📊 個股深度診斷與互動圖表中心</span>
            <span>•</span>
            <span>點擊下方清單股票即時載入</span>
          </div>
          <h3 id="panel-stock-title" class="text-xl font-bold text-white flex items-center gap-2">
            2383 台光電 <span class="text-sm font-normal text-slate-400">｜ AI PCB / CCL 霸主</span>
          </h3>
        </div>
        <div id="stock-quick-buttons" class="flex flex-wrap gap-1.5"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-5">
        <div class="lg:col-span-7 space-y-4">
          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-300">📈 互動式均線 K 線圖 (近 10 日走勢)</span>
              <span class="text-[10px] text-slate-400 font-mono">MA5/10/20/60</span>
            </div>
            <div class="relative w-full h-48 bg-slate-950 rounded-lg overflow-hidden border border-slate-800/80">
              <canvas id="klineCanvas" class="w-full h-full cursor-crosshair"></canvas>
            </div>
          </div>
          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-300">📊 三大法人近 10 日買賣超長條圖 (外資:藍 ｜ 投信:橘)</span>
            </div>
            <div class="relative w-full h-28 bg-slate-950 rounded-lg overflow-hidden border border-slate-800/80">
              <canvas id="chipsCanvas" class="w-full h-full"></canvas>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4 flex flex-col justify-between">
          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-slate-800">
              <h4 class="text-xs font-bold text-slate-200">🎯 AI 四維度戰力深度評分</h4>
              <span id="ai-total-score" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">總分：92 分</span>
            </div>
            <div id="dimension-bars" class="space-y-2 text-xs"></div>
          </div>

          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-3">
            <h4 class="text-xs font-bold text-slate-200">🧮 關鍵攻防價位與波段操作策略</h4>
            <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono">
              <div class="bg-slate-950 p-2.5 rounded-lg border border-slate-800">
                <div class="text-[10px] text-slate-400 mb-1">建議觀察區間</div>
                <div id="strat-entry" class="font-bold text-blue-400">4,950 ~ 5,050</div>
              </div>
              <div class="bg-slate-950 p-2.5 rounded-lg border border-slate-800">
                <div class="text-[10px] text-slate-400 mb-1">停損防守價</div>
                <div id="strat-stop" class="font-bold text-red-400">4,780</div>
              </div>
              <div class="bg-slate-950 p-2.5 rounded-lg border border-slate-800">
                <div class="text-[10px] text-slate-400 mb-1">波段目標價</div>
                <div id="strat-target" class="font-bold text-amber-400">5,450</div>
              </div>
            </div>
            <div id="strat-desc" class="text-xs text-slate-300 bg-slate-950 p-3 rounded-lg border border-slate-800 leading-relaxed"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 區塊 5：個股清單總表（140+ 檔熱門股） -->
    <section class="glass-card rounded-xl p-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
        <div>
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span>📋</span> AI 波段選股與籌碼清單總表（共 140+ 檔熱門標的）
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">點擊任一股票或星號可加入自選股與檢視深度圖表</p>
        </div>
      </div>
      <div class="overflow-x-auto max-h-[600px] overflow-y-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead class="sticky top-0 bg-slate-900 z-10">
            <tr class="border-b border-slate-800 text-slate-400 font-mono">
              <th class="py-3 px-3 w-10">追蹤</th>
              <th class="py-3 px-3">代號 / 名稱</th>
              <th class="py-3 px-3">AI 次族群</th>
              <th class="py-3 px-3 text-right">收盤價</th>
              <th class="py-3 px-3">多空均線狀態</th>
              <th class="py-3 px-3">法人籌碼動向</th>
              <th class="py-3 px-3">財報與基本面催化劑</th>
              <th class="py-3 px-3">操作策略</th>
              <th class="py-3 px-3 text-center">診斷</th>
            </tr>
          </thead>
          <tbody id="stock-tbody" class="divide-y divide-slate-800/70"></tbody>
        </table>
      </div>
    </section>

  </main>

  <!-- 彈窗：我的自選股管理中心 -->
  <div id="watchlist-modal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="glass-card max-w-xl w-full rounded-xl p-6 border border-slate-700 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-base text-white flex items-center gap-2">⭐ 管理我的自選股清單</h3>
        <button onclick="closeWatchlistModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <p class="text-xs text-slate-400">您可以手動輸入台股代號與名稱新增至自選股。資料會自動保存在您的瀏覽器中。</p>
      <div class="flex gap-2">
        <input type="text" id="new-stock-code" placeholder="代號 (例如 2330)" class="w-28 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none font-mono">
        <input type="text" id="new-stock-name" placeholder="名稱 (例如 台積電)" class="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none">
        <button onclick="addNewCustomStock()" class="px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium">新增自選</button>
      </div>
      <div class="max-h-60 overflow-y-auto space-y-2 pt-2 border-t border-slate-800" id="watchlist-items-container"></div>
      <div class="flex justify-end pt-2">
        <button onclick="closeWatchlistModal()" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs">完成並關閉</button>
      </div>
    </div>
  </div>

  <script>
    const SECTORS = [
      { id: 'ALL', name: '全部 AI 次族群 (140+)' },
      { id: 'PCB', name: '① AI PCB / 載板 / CCL (20)' },
      { id: 'SEMI', name: '② 先進封裝設備 / 特化 (20)' },
      { id: 'CPO', name: '③ 光通訊與 CPO 矽光子 (20)' },
      { id: 'MEM', name: '④ AI 記憶體與控制 IC (20)' },
      { id: 'PASSIVE', name: '⑤ 被動元件與高階銅箔 (20)' },
      { id: 'SERVER', name: '⑥ 伺服器 / 液冷散熱 (20)' },
      { id: 'EDGE', name: '⑦ 邊緣 AI 與晶片設計 (20)' }
    ];

    let activeSector = 'ALL';
    let activeNewsType = 'ALL';
    let currentScreener = 'ALL';
    let currentSelectedStockCode = '2383';

    const NEWS_DATA = [
      { id: 1, type: 'EARNINGS', typeLabel: '📑 大廠財報與產能', sector: 'PCB', sectorName: 'AI PCB / CCL', impact: 'BULL', impactText: '🔥 真波段主流', title: '金像電獲 Amazon 私募、H1 毛利率飆 34.7%！欣興預警 2027 高階材料缺口 20%', summary: 'AI 伺服器高層數板與 ABF 載板需求全面爆發，金像電、台光電、欣興營運創高。', translation: 'PCB 與高階 CCL 是目前財報實質獲利兌現度最高的 AI 次族群。', tickers: ['2383 台光電', '2368 金像電', '3037 欣興'] },
      { id: 2, type: 'TECH', typeLabel: '🚀 新技術與產業突破', sector: 'CPO', sectorName: '光通訊與 CPO', impact: 'BULL', impactText: '🔥 真波段利多', title: '400G/800G/1.6T 光模組需求狂甩 CPO 近 70 倍！台積電 COUPE 矽光子領軍商轉', summary: '法人預估光收發模組需求達 2.45 億個，光聖前 10 月營收年增近九成。', translation: '光通訊族群享受 800G 放量與 2027 CPO 商轉雙引擎。', tickers: ['6442 光聖', '4971 IET-KY', '3081 聯亞'] },
      { id: 3, type: 'TRUMP', typeLabel: '🦅 川普與政經關稅', sector: 'SEMI', sectorName: '先進封裝設備', impact: 'WATCH', impactText: '🛡️ 結構性分歧', title: '川普預告半導體新關稅鎖定美國在地製造！費半短線回檔 6.72%', summary: '要求更高比例的先進封裝留在美國境內，具備美廠產能與獨佔性的台積電抗壓較高。', translation: '台積電 (2330) 回檔至 2,385 元，CoWoS 設備（萬潤、弘塑）逢急跌可留意。', tickers: ['2330 台積電', '6187 萬潤', '3131 弘塑'] }
    ];

    // AI 七大次族群：每族群精選 20 檔熱門股總資料庫 (共 140+ 檔)
    let STOCK_DATABASE = {
      // ① AI PCB / 載板 / CCL (20檔)
