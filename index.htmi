      '6442': { code: '6442', name: '光聖', sector: 'CPO', sectorLabel: '光通訊/CPO', price: '1,495', change: '+3.10%', isUp: true, maStatus: 'BULL', maText: '🔥 強勢多頭', chips: '投信波段認養', fundamentals: '前 10 月營收年增近九成', strategy: '沿 10MA 操作', entry: '1,430 ~ 1,470', stop: '1,380', target: '1,680', stratDesc: '800G 光模組出貨爆發，美系 CSP 核心供應商。', scoreTotal: 94, scores: { tech: 96, chips: 93, fund: 95, news: 92 }, klineData: [1380, 1400, 1420, 1410, 1440, 1460, 1450, 1480, 1470, 1495], chipsForeign: [300, 450, 200, 500, 350, 600, 400, 700, 550, 800], chipsInvestment: [500, 620, 700, 580, 750, 810, 690, 850, 780, 920] },
      '8299': { code: '8299', name: '群聯', sector: 'MEM', sectorLabel: 'NAND 控制IC', price: '1,845', change: '+0.00%', isUp: true, maStatus: 'CONSOLIDATE', maText: '⏳ 11/6法說前整理', chips: '外資小幅回補', fundamentals: '企業級 SSD 與 aiDAPTIV+', strategy: '突破 1,895 再加碼', entry: '1,800 ~ 1,835', stop: '1,750', target: '2,050', stratDesc: '法說前籌碼沉澱，守穩前低續抱。', scoreTotal: 87, scores: { tech: 85, chips: 86, fund: 90, news: 88 }, klineData: [1800, 1830, 1810, 1850, 1860, 1840, 1820, 1855, 1840, 1845], chipsForeign: [-100, 150, -50, 200, 120, -80, 180, 220, 100, 166], chipsInvestment: [300, 400, 350, 450, 420, 390, 430, 460, 440, 480] },
      '3017': { code: '3017', name: '奇鋐', sector: 'SERVER', sectorLabel: '液冷散熱', price: '3,145', change: '+0.00%', isUp: true, maStatus: 'BULL', maText: '🔥 高檔強勢整理', chips: '外資目標價喊近四千', fundamentals: '水冷板與 CDU 放量', strategy: '3,100 頸線支撐守穩', entry: '3,080 ~ 3,130', stop: '2,950', target: '3,600', stratDesc: '水冷散熱龍頭，於歷史高檔進行籌碼換手。', scoreTotal: 90, scores: { tech: 89, chips: 91, fund: 92, news: 88 }, klineData: [3050, 3100, 3080, 3120, 3150, 3130, 3110, 3160, 3140, 3145], chipsForeign: [800, -200, 400, 650, 300, -150, 500, 720, 400, 610], chipsInvestment: [700, 850, 600, 900, 750, 820, 910, 880, 790, 950] },
      '2454': { code: '2454', name: '聯發科', sector: 'EDGE', sectorLabel: 'IC設計/邊緣AI', price: '1,425', change: '+1.06%', isUp: true, maStatus: 'BULL', maText: '🔥 投信認養', chips: '內資合力拱高', fundamentals: '天玑 9400 與車用晶片', strategy: '沿 10MA 逢低佈局', entry: '1,390 ~ 1,415', stop: '1,340', target: '1,600', stratDesc: '旗艦晶片市佔率提升，邊緣 AI 龍頭。', scoreTotal: 89, scores: { tech: 90, chips: 88, fund: 91, news: 87 }, klineData: [1360, 1390, 1375, 1410, 1420, 1405, 1430, 1415, 1420, 1425], chipsForeign: [500, 800, 400, 950, 700, 850, 600, 1020, 880, 1100], chipsInvestment: [800, 1050, 950, 1200, 1100, 1250, 1150, 1320, 1280, 1400] }
    };

    let watchlist = JSON.parse(localStorage.getItem('cubeai_watchlist')) || ['2383', '6442', '2330', '6187', '3017', '2454'];

    function renderSectorTabs() {
      const container = document.getElementById('sector-tabs');
      container.innerHTML = SECTORS.map(s => `
        <button onclick="selectSector('${s.id}')"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition border ${
            activeSector === s.id ? 'bg-blue-600 text-white border-blue-500 shadow-md' : 'bg-slate-900/90 text-slate-300 border-slate-800 hover:bg-slate-800'
          }">
          ${s.name}
        </button>
      `).join('');
    }

    function selectSector(sectorId) {
      activeSector = sectorId;
      renderSectorTabs();
      renderStocksTable();
    }

    function filterNewsType(type) {
      activeNewsType = type;
      document.querySelectorAll('.news-type-btn').forEach(btn => {
        btn.className = 'news-type-btn px-2.5 py-1 rounded bg-slate-900 text-slate-400 hover:text-white';
      });
      event.target.className = 'news-type-btn px-2.5 py-1 rounded bg-slate-800 text-white font-medium';
      renderNews();
    }

    function renderNews() {
      const grid = document.getElementById('news-grid');
      const filtered = NEWS_DATA.filter(n => activeNewsType === 'ALL' || n.type === activeNewsType);
      grid.innerHTML = filtered.map(n => `
        <div class="glass-card rounded-xl p-4 flex flex-col justify-between hover:border-slate-600 transition">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300">${n.typeLabel}</span>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded border bg-red-500/20 text-red-400 border-red-500/30">${n.impactText}</span>
            </div>
            <h4 class="font-bold text-sm text-white mb-2 leading-snug">${n.title}</h4>
            <p class="text-xs text-slate-400 leading-relaxed mb-3">${n.summary}</p>
          </div>
          <div class="space-y-2 pt-3 border-t border-slate-800/80">
            <div class="bg-slate-900/90 p-2 rounded-lg border-l-2 border-blue-500 text-xs">
              <span class="font-bold text-blue-400">💡 實戰翻譯：</span>${n.translation}
            </div>
          </div>
        </div>
      `).join('');
    }

    function applyScreener(type) {
      currentScreener = type;
      document.querySelectorAll('.screener-btn').forEach(btn => {
        btn.className = 'screener-btn px-3 py-1.5 rounded-lg bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800';
      });
      event.target.className = 'screener-btn px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-medium';
      renderStocksTable();
    }

    function toggleWatchlist(code) {
      const idx = watchlist.indexOf(code);
      if (idx > -1) watchlist.splice(idx, 1);
      else watchlist.push(code);
      localStorage.setItem('cubeai_watchlist', JSON.stringify(watchlist));
      document.getElementById('watchlist-count').textContent = watchlist.length;
      renderStocksTable();
    }

    function selectStockForPanel(code) {
      currentSelectedStockCode = code;
      const data = STOCK_DATABASE[code] || {
        code, name: '熱門追蹤股', sectorLabel: 'AI 核心標的', price: '---', change: '+1.20%', isUp: true,
        maStatus: 'BULL', maText: '🔥 多頭排列', chips: '法人持續鎖碼', fundamentals: '基本面成長動能強勁',
        strategy: '逢低量縮分批承接', entry: '依盤中均線', stop: '月線防守', target: '波段新高',
        stratDesc: '此為 AI 熱門追蹤標的，具備良好的籌碼與技術支撐。', scoreTotal: 88,
        scores: { tech: 88, chips: 87, fund: 89, news: 88 },
        klineData: [100, 102, 101, 105, 107, 106, 108, 110, 109, 112],
        chipsForeign: [100, 200, -50, 300, 150, 220, 180, 250, 300, 400],
        chipsInvestment: [150, 180, 220, 200, 250, 280, 300, 320, 350, 410]
      };

      document.getElementById('panel-stock-title').innerHTML = `${data.code} ${data.name} <span class="text-sm font-normal text-slate-400">｜ ${data.sectorLabel}</span>`;
      document.getElementById('ai-total-score').textContent = `總分：${data.scoreTotal} 分`;

      document.getElementById('dimension-bars').innerHTML = `
        <div class="space-y-2">
          <div><div class="flex justify-between text-slate-300 mb-0.5"><span>📈 技術面</span><span class="font-mono font-bold text-blue-400">${data.scores.tech} 分</span></div><div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden"><div class="h-full bg-blue-500 rounded-full" style="width: ${data.scores.tech}%"></div></div></div>
          <div><div class="flex justify-between text-slate-300 mb-0.5"><span>👥 籌碼面</span><span class="font-mono font-bold text-amber-400">${data.scores.chips} 分</span></div><div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden"><div class="h-full bg-amber-500 rounded-full" style="width: ${data.scores.chips}%"></div></div></div>
          <div><div class="flex justify-between text-slate-300 mb-0.5"><span>📑 基本面</span><span class="font-mono font-bold text-emerald-400">${data.scores.fund} 分</span></div><div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden"><div class="h-full bg-emerald-500 rounded-full" style="width: ${data.scores.fund}%"></div></div></div>
          <div><div class="flex justify-between text-slate-300 mb-0.5"><span>📰 消息面</span><span class="font-mono font-bold text-indigo-400">${data.scores.news} 分</span></div><div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden"><div class="h-full bg-indigo-500 rounded-full" style="width: ${data.scores.news}%"></div></div></div>
        </div>
      `;

      document.getElementById('strat-entry').textContent = data.entry;
      document.getElementById('strat-stop').textContent = data.stop;
      document.getElementById('strat-target').textContent = data.target;
      document.getElementById('strat-desc').innerHTML = `<strong>AI 綜合建議：</strong> ${data.stratDesc}`;

      drawKlineChart(data.klineData);
      drawChipsChart(data.chipsForeign, data.chipsInvestment);
      renderQuickButtons();
    }

    function renderQuickButtons() {
      const container = document.getElementById('stock-quick-buttons');
      const keys = Object.keys(STOCK_DATABASE).slice(0, 8);
      container.innerHTML = keys.map(code => {
        const s = STOCK_DATABASE[code];
        const isSelected = code === currentSelectedStockCode;
        return `<button onclick="selectStockForPanel('${code}')" class="px-2.5 py-1 rounded text-xs font-mono transition border ${isSelected ? 'bg-blue-600 text-white border-blue-500' : 'bg-slate-900 text-slate-300 border-slate-800'}">${s.code} ${s.name}</button>`;
      }).join('');
    }

    function renderStocksTable() {
      const tbody = document.getElementById('stock-tbody');
      const filtered = Object.values(STOCK_DATABASE).filter(s => {
        const matchSector = activeSector === 'ALL' || s.sector === activeSector;
        let matchScreener = true;
        if (currentScreener === 'BULL_INVESTMENT') matchScreener = s.maStatus === 'BULL';
        if (currentScreener === 'PULLBACK_SUPPORT') matchScreener = s.maStatus === 'PULLBACK';
        if (currentScreener === 'FOREIGN_DEFENSE') matchScreener = s.code === '2330' || s.code === '2454';
        return matchSector && matchScreener;
      });

      tbody.innerHTML = filtered.map(s => {
        const isFav = watchlist.includes(s.code);
        const priceColor = s.isUp ? 'text-red-400' : 'text-emerald-400';
        const maBadge = s.maStatus === 'BULL' ? 'bg-red-500/15 text-red-400 border-red-500/30' : 'bg-amber-500/15 text-amber-400 border-amber-500/30';

        return `
          <tr class="hover:bg-slate-800/40 transition cursor-pointer" onclick="selectStockForPanel('${s.code}')">
            <td class="py-3 px-3 text-center" onclick="event.stopPropagation(); toggleWatchlist('${s.code}')">
              <span class="text-base cursor-pointer">${isFav ? '⭐' : '☆'}</span>
            </td>
            <td class="py-3 px-3 font-mono font-bold text-white">${s.code} <span class="font-sans font-semibold text-slate-200 ml-1">${s.name}</span></td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border text-[11px]">${s.sectorLabel}</span></td>
            <td class="py-3 px-3 text-right font-mono font-bold ${priceColor}">${s.price} <span class="text-[11px]">(${s.change})</span></td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded border text-[11px] ${maBadge}">${s.maText}</span></td>
            <td class="py-3 px-3 text-slate-300">${s.chips}</td>
            <td class="py-3 px-3 text-slate-300">${s.fundamentals}</td>
            <td class="py-3 px-3 font-medium text-amber-300">${s.strategy}</td>
            <td class="py-3 px-3 text-center">
              <button onclick="event.stopPropagation(); selectStockForPanel('${s.code}')" class="px-2 py-1 rounded bg-blue-600/20 text-blue-400 text-[11px]">診斷</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function drawKlineChart(prices) {
      const canvas = document.getElementById('klineCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const min = Math.min(...prices) * 0.98, max = Math.max(...prices) * 1.02, range = max - min, stepX = canvas.width / (prices.length + 1);

      ctx.strokeStyle = '#1F2937';
      for (let i = 1; i <= 4; i++) { let y = (canvas.height / 5) * i; ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }

      ctx.beginPath(); ctx.strokeStyle = '#3B82F6'; ctx.lineWidth = 2;
      prices.forEach((p, idx) => {
        const x = stepX * (idx + 1), y = canvas.height - ((p - min) / range) * (canvas.height - 30) - 15;
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();

      prices.forEach((p, idx) => {
        const x = stepX * (idx + 1), y = canvas.height - ((p - min) / range) * (canvas.height - 30) - 15;
        ctx.fillStyle = idx === 0 || p >= prices[idx - 1] ? '#EF4444' : '#10B981';
        ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2); ctx.fill();
      });
    }

    function drawChipsChart(foreign, investment) {
      const canvas = document.getElementById('chipsCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const max = Math.max(...[...foreign, ...investment].map(v => Math.abs(v))) * 1.2 || 1000, stepX = canvas.width / (foreign.length + 1), centerY = canvas.height / 2;

      ctx.strokeStyle = '#334155'; ctx.beginPath(); ctx.moveTo(0, centerY); ctx.lineTo(canvas.width, centerY); ctx.stroke();

      foreign.forEach((val, idx) => {
        const x = stepX * (idx + 1), barH = (Math.abs(val) / max) * (centerY - 10);
        ctx.fillStyle = val >= 0 ? '#3B82F6' : '#EF4444';
        ctx.fillRect(x - 4, val >= 0 ? centerY - barH : centerY, 3, barH);
        const invVal = investment[idx], invBarH = (Math.abs(invVal) / max) * (centerY - 10);
        ctx.fillStyle = invVal >= 0 ? '#F59E0B' : '#10B981';
        ctx.fillRect(x, invVal >= 0 ? centerY - invBarH : centerY, 3, invBarH);
      });
    }

    function openWatchlistModal() {
      document.getElementById('watchlist-modal').classList.remove('hidden');
      renderWatchlistModalItems();
    }
    function closeWatchlistModal() { document.getElementById('watchlist-modal').classList.add('hidden'); renderStocksTable(); }

    function renderWatchlistModalItems() {
      const container = document.getElementById('watchlist-items-container');
      container.innerHTML = watchlist.map(code => {
        const s = STOCK_DATABASE[code] || { code, name: '自選追蹤股', sectorLabel: '自訂標的' };
        return `
          <div class="flex items-center justify-between bg-slate-950 p-2.5 rounded-lg border border-slate-800 text-xs">
            <div><span class="font-mono font-bold text-white">${s.code}</span> <span class="text-slate-300 ml-2">${s.name}</span></div>
            <button onclick="removeWatchlist('${code}')" class="text-red-400 hover:text-red-300 text-xs px-2 py-1 bg-red-500/15 rounded">移除</button>
          </div>
        `;
      }).join('');
    }

    function removeWatchlist(code) {
      watchlist = watchlist.filter(c => c !== code);
      localStorage.setItem('cubeai_watchlist', JSON.stringify(watchlist));
      document.getElementById('watchlist-count').textContent = watchlist.length;
      renderWatchlistModalItems();
    }

    function addNewCustomStock() {
      const code = document.getElementById('new-stock-code').value.trim();
      const name = document.getElementById('new-stock-name').value.trim();
      if (!code || !name) { alert('請輸入股票代號與名稱！'); return; }

      STOCK_DATABASE[code] = {
        code, name, sector: 'PCB', sectorLabel: '自訂追蹤股', price: '---', change: '+0.00%', isUp: true,
        maStatus: 'BULL', maText: '🔥 自訂追蹤', chips: '即時籌碼連線中', fundamentals: '使用者自訂標的',
        strategy: '手動觀察支撐與壓力', entry: '依盤中走勢', stop: '前低防守', target: '波段目標',
        stratDesc: '此為您手動加入的自選標的，系統已自動掛載四維度戰力與互動圖表。',
        scoreTotal: 85, scores: { tech: 85, chips: 85, fund: 85, news: 85 },
        klineData: [100, 102, 101, 105, 107, 106, 108, 110, 109, 112],
        chipsForeign: [100, 200, -50, 300, 150, 220, 180, 250, 300, 400],
        chipsInvestment: [150, 180, 220, 200, 250, 280, 300, 320, 350, 410]
      };

      if (!watchlist.includes(code)) watchlist.push(code);
      localStorage.setItem('cubeai_watchlist', JSON.stringify(watchlist));
      document.getElementById('new-stock-code').value = '';
      document.getElementById('new-stock-name').value = '';
      document.getElementById('watchlist-count').textContent = watchlist.length;
      renderWatchlistModalItems();
      selectStockForPanel(code);
    }

    // 初始化
    document.getElementById('watchlist-count').textContent = watchlist.length;
    renderSectorTabs();
    renderNews();
    renderStocksTable();
    selectStockForPanel('2383');
  </script>
</body>
</html>
